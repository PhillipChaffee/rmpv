def charset_conv.mp_charset_guess
  (buf : Slice Std.U8) (user_cp : Slice Std.U8) (flags : Std.I32) :
  Result (Slice Std.U8)
  := do
  let user_cp1 ← bstr.bstr0 user_cp
  let i ← clib.cstr_at user_cp1 0#usize
  if i = 43#u8
  then
    core.slice.index.Slice.index
      (core.slice.index.SliceIndexRangeFromUsizeSlice Std.U8) user_cp1
      { start := 1#usize }
  else
    let o ← charset_conv.ms_bom_guess buf
    match o with
    | none =>
      let r ← bstr.bstr_validate_utf8 buf
      if r >= 0#i32
      then ok (Array.to_slice charset_conv.ENC_UTF8)
      else
        if r > (-8)#i32
        then
          let i1 ← lift (flags &&& charset_conv.MP_ICONV_ALLOW_CUTOFF)
          if i1 != 0#i32
          then ok (Array.to_slice charset_conv.ENC_UTF8)
          else
            let s ←
              lift (Array.to_slice
                (Array.make 4#usize [ 97#u8, 117#u8, 116#u8, 111#u8 ]))
            let i2 ← clib.strcasecmp user_cp1 s
            if i2 = 0#i32
            then ok (Array.to_slice charset_conv.ENC_UTF8_BROKEN)
            else ok user_cp1
        else
          let s ←
            lift (Array.to_slice
              (Array.make 4#usize [ 97#u8, 117#u8, 116#u8, 111#u8 ]))
          let i1 ← clib.strcasecmp user_cp1 s
          if i1 = 0#i32
          then ok (Array.to_slice charset_conv.ENC_UTF8_BROKEN)
          else ok user_cp1
    | some bom_cp => ok bom_cp

